rules_version = '2';
// כללי האבטחה של משחק "האחוזון העליון".
// מדביקים את כל הקובץ ב־Firebase Console ← Firestore Database ← Rules, ומחליפים את האימייל ברשימה.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- המארגנים: רק האימיילים ברשימה יכולים לפתוח משחק, לראות תשובות ולערוך שאלות ----
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email in ['kerenmor@mail.tau.ac.il'];
    }
    function game(g) { return get(/databases/$(database)/documents/games/$(g)).data; }
    function isCurrent(g) { return get(/databases/$(database)/documents/config/current).data.gameId == g; }

    // איזה משחק פעיל כרגע
    match /config/current {
      allow read: if true;
      allow write: if isAdmin();
    }

    // השאלות והתשובות הנכונות: למארגנים בלבד
    match /admin/{docId} {
      allow read, write: if isAdmin();
    }

    match /games/{g} {
      // מצב המשחק (השאלה הפתוחה, בלי התשובה הנכונה עד החשיפה): כולם קוראים, רק מארגנים כותבים
      allow read: if true;
      allow write: if isAdmin();

      // משתתף: נרשם פעם אחת, רק לעצמו, ורק בזמן ההצטרפות
      match /players/{uid} {
        allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
        allow create: if request.auth != null && request.auth.uid == uid
          && isCurrent(g)
          && game(g).phase == 'lobby'
          && request.resource.data.keys().hasOnly(['name', 'joinedAt', 'alive'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 24
          && request.resource.data.alive == true
          && request.resource.data.joinedAt == request.time;
        allow update, delete: if isAdmin();
      }

      // תשובה: אחת לכל שאלה, רק בזמן שהשאלה פתוחה, ורק למי שעדיין במשחק. אי אפשר לשנות אחרי שליחה.
      match /answers/{answerId} {
        allow get: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
        allow list: if isAdmin();
        allow create: if request.auth != null
          && isCurrent(g)
          && answerId == string(game(g).qn) + '_' + request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'q', 'choice', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.q == game(g).qn
          && request.resource.data.choice is int
          && request.resource.data.choice >= 0 && request.resource.data.choice < game(g).opts.size()
          && request.resource.data.at == request.time
          && game(g).phase == 'question'
          && game(g).acceptingAnswers == true
          && request.time < game(g).openedAt + duration.value(game(g).seconds, 's')
          && get(/databases/$(database)/documents/games/$(g)/players/$(request.auth.uid)).data.alive == true;
        allow update, delete: if false;
      }
    }
  }
}
